{"at":"2026-11-11T00:00:00+00:00","by":null,"data":{"text":"A shared core with all domain logic in packs, model calls wrapped by deterministic gates, and every result written to an append-only artifact chain.","title":"How OMLi works","x":0,"y":0},"kind":"node.add","node":"root","op":"starter-001","v":1}
{"at":"2026-11-11T00:00:00+00:00","by":null,"data":{"module":"omli.packs","text":"All domain logic lives here as versioned data. A pack is immutable per version; agents apply it and never change it.","title":"Packs","x":-300,"y":-180},"kind":"node.add","node":"packs","op":"starter-002","v":1}
{"at":"2026-11-11T00:00:00+00:00","by":null,"data":{"module":"omli.agents","text":"Generic machinery that applies a pack: pre-gate, model, post-gate, then a successor artifact.","title":"Agents","x":0,"y":-200},"kind":"node.add","node":"agents","op":"starter-003","v":1}
{"at":"2026-11-11T00:00:00+00:00","by":null,"data":{"module":"omli.gates","text":"Cheap deterministic checks before and after every model call, so a model is never the first or last decision-maker.","title":"Gates","x":300,"y":-180},"kind":"node.add","node":"gates","op":"starter-004","v":1}
{"at":"2026-11-11T00:00:00+00:00","by":null,"data":{"module":"omli.models","text":"Generic transport to open and local models; prompts and thresholds come from packs.","title":"Model adapters","x":340,"y":20},"kind":"node.add","node":"models","op":"starter-005","v":1}
{"at":"2026-11-11T00:00:00+00:00","by":null,"data":{"module":"omli.core","text":"Resolves a pack's model choice against the model registry and fails loudly when it cannot.","title":"Router","x":300,"y":200},"kind":"node.add","node":"core","op":"starter-006","v":1}
{"at":"2026-11-11T00:00:00+00:00","by":null,"data":{"module":"omli.artifacts","text":"The workflow state and the audit trail: immutable records, changed only by linked successors.","title":"Artifact chain","x":0,"y":220},"kind":"node.add","node":"artifacts","op":"starter-007","v":1}
{"at":"2026-11-11T00:00:00+00:00","by":null,"data":{"module":"omli.integrity","text":"A hash chain over a log's exact bytes, sealed and verified; signing makes a re-seal detectable.","title":"Integrity","x":-300,"y":200},"kind":"node.add","node":"integrity","op":"starter-008","v":1}
{"at":"2026-11-11T00:00:00+00:00","by":null,"data":{"module":"omli.events","text":"Choreography, not orchestration: agents react to events and nothing drives them centrally.","title":"Event bus","x":-340,"y":20},"kind":"node.add","node":"events","op":"starter-009","v":1}
{"at":"2026-11-11T00:00:00+00:00","by":null,"data":{"module":"omli.governance","text":"The only cross-agent reader of the artifact store. It reads for audit and never writes.","title":"Governance","x":-150,"y":380},"kind":"node.add","node":"governance","op":"starter-010","v":1}
{"at":"2026-11-11T00:00:00+00:00","by":null,"data":{"module":"omli.sensitivity","text":"Tags on provenance that accumulate down the chain and can stop a route.","title":"Sensitivity tags","x":150,"y":380},"kind":"node.add","node":"sensitivity","op":"starter-011","v":1}
{"at":"2026-11-11T00:00:00+00:00","by":null,"data":{"module":"omli.connections","text":"The one place an external target and its credential reference are named, default-deny.","title":"Connection registry","x":500,"y":-20},"kind":"node.add","node":"connections","op":"starter-012","v":1}
{"at":"2026-11-11T00:00:00+00:00","by":null,"data":{"module":"omli.home","text":"Where OMLi writes by default: OMLI_HOME, else the current directory, never the package.","title":"OMLI_HOME","x":-500,"y":-20},"kind":"node.add","node":"home","op":"starter-013","v":1}
{"at":"2026-11-11T00:00:00+00:00","by":null,"data":{"module":"omli.boards","text":"One append-only edit log per board; the board is replayed from it and sealed with integrity.","title":"Boards","x":-150,"y":-380},"kind":"node.add","node":"boards","op":"starter-014","v":1}
{"at":"2026-11-11T00:00:00+00:00","by":null,"data":{"module":"omli.ui","text":"An optional server on 127.0.0.1 behind each user's own key login.","title":"Local UI","x":150,"y":-380},"kind":"node.add","node":"ui","op":"starter-015","v":1}
